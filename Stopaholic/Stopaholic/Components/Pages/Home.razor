@page "/"

@using Stopaholic.Shared.Models;

<PageTitle>Stopaholic</PageTitle>

<div class="homepage-container">
    <div class="homepage-header">
        <h1>Stopaholic</h1>
        <h3>Your Want List</h3>
        <h5>Help Manage Your Monthly Wants to Increase Your Savings</h5>
    </div>

    <div class="list-display">
        <h2>Monthly Wants List</h2>
        <button class="btn-primary">Add Item to List</button>
        <button class="btn-secondary">Create Account</button>

        <ul>
            @if (Items != null && Items.Any())
            {
                @foreach (var item in Items)
                {
                    <li>@item.Name</li>
                }
            }
            else
            {
                <li>No items available</li>
            }
        </ul>
    </div>
</div>

@code {
    private List<Item> Items = new List<Item>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Make an HTTP GET request to fetch items
            var httpClient = new HttpClient();
            Items = await httpClient.GetFromJsonAsync<List<Item>>("https://localhost:5001/api/item");

            if (Items == null)
            {
                Items = new List<Item>(); // Fallback to an empty list if null is returned
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching items: {ex.Message}");
        }
    }
}
