@page "/"

@using Stopaholic.Shared.Models;
@inject HttpClient Http

<PageTitle>Stopaholic</PageTitle>

<div class="homepage-container">
    <div class="homepage-header">
        <h1>Stopaholic</h1>
        <h3>Your Want List</h3>
        <h5>Help Manage Your Monthly Wants to Increase Your Savings</h5>
    </div>

    <div class="list-display">
        <h2>Monthly Wants List</h2>
        <button class="btn-primary" @onclick="ShowAddItemModal">Add Item to List</button>
        <button class="btn-secondary">Create Account</button>

        <table class="table-no-borders">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Purchase Link</th>
                    <th>Total Cost</th>
                    <th>Priority</th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Any())
                {
                    @foreach (var item in Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td><a href="@item.PurchaseLink" target="_blank">View Item</a></td>
                            <td>@item.TotalCost.ToString("C")</td>
                            <td>@item.Priority</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center;">No items available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Item> Items = new List<Item>();
    private Item NewItem = new Item();
    private bool IsModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            int userId = 1; // Temporary until login is added
            var requestUrl = $"https://localhost:7269/item?userId={userId}";
            Items = await Http.GetFromJsonAsync<List<Item>>(requestUrl) ?? new List<Item>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching items: {ex.Message}");
        }
    }

    private void ShowAddItemModal()
    {
        NewItem = new Item();
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
    }

    private async Task AddItem()
    {
        NewItem.UserId = 1; // Replace with logged-in user ID when authentication is added
        await Http.PostAsJsonAsync("/item", NewItem);
        Items.Add(NewItem);
        CloseModal();
    }
}
