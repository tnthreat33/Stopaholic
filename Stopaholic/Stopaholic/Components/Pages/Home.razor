@page "/"

@using Stopaholic.Shared.Models;
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthStateProvider AuthenticationStateProvider

<PageTitle>Stopaholic</PageTitle>

<div class="homepage-container">
    <div class="homepage-header">
        <h1>Stopaholic</h1>
        <h3>Your Want List</h3>
        <h5>Help Manage Your Monthly Wants to Increase Your Savings</h5>
    </div>

    <div class="list-display">
        <h2>Monthly Wants List</h2>
        <button class="btn-primary" @onclick="ShowAddItemModal">Add Item to List</button>
        <button class="btn-secondary" @onclick="NavigateToLogin">Account</button>

        <table class="table-no-borders">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Purchase Link</th>
                    <th>Total Cost</th>
                    <th>Priority</th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Any())
                {
                    @foreach (var item in Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td><a href="@item.PurchaseLink" target="_blank">View Item</a></td>
                            <td>@item.TotalCost.ToString("C")</td>
                            <td>@item.Priority</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center;">No items available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsModalOpen)
{
    <div class="modal">
        <div class="modal-content">
            <h2>Add New Item</h2>

            <label>Name:</label>
            <input type="text" @bind="NewItem.Name" />

            <label>Purchase Link:</label>
            <input type="text" @bind="NewItem.PurchaseLink" />

            <label>Total Cost:</label>
            <input type="number" @bind="NewItem.TotalCost" />

            <label>Priority:</label>
            <select @bind="NewItem.Priority">
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
            </select>

            <div class="modal-buttons">
                <button class="btn-primary" @onclick="AddItem">Add</button>
                <button class="btn-secondary" @onclick="CloseModal">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Item> Items = new List<Item>();
    private Item NewItem = new Item();
    private bool IsModalOpen = false;
    private int? UserId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Get authentication state and extract user ID if authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            // Get the logged-in user's ID from the ClaimsPrincipal
            UserId = int.Parse(user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value);

            if (UserId.HasValue)
            {
                // Fetch items based on the user ID
                await FetchItemsForUser(UserId.Value);
            }
        }
        else
        {
            // If the user is not authenticated, redirect to the login page
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task FetchItemsForUser(int userId)
    {
        try
        {
            var requestUrl = $"https://localhost:7269/item?userId={userId}";
            Items = await Http.GetFromJsonAsync<List<Item>>(requestUrl) ?? new List<Item>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching items: {ex.Message}");
        }
    }

    private void ShowAddItemModal()
    {
        NewItem = new Item();
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
    }

    private async Task AddItem()
    {
        if (UserId.HasValue)
        {
            NewItem.UserId = UserId.Value;  // Use the logged-in user's ID
            await Http.PostAsJsonAsync("/item", NewItem);
            Items.Add(NewItem);
            CloseModal();
        }
    }

    private void NavigateToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}
